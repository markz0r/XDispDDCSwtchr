{
  "backend": "cli",
  "models": [
    {
      "name": "U4025QW",
      "input_select": { "code": "0x60", "values": { "DP1": 15, "DP2": 16, "HDMI1": 17, "HDMI2": 18, "USB-C": 27 } },
      "pip": {
        "toggle_code": "0xE3",
        "on_value": 1,
        "off_value": 0,
        "sources": ["HDMI1", "HDMI2", "DP1", "DP2", "USB-C"],
        "positions": ["TopLeft", "TopRight", "BottomLeft", "BottomRight"],
        "sizes": ["Small", "Medium", "Large"],
        "swap_code": "0xE4",
        "swap_value": 1,
        "source_code": "0xE5",
        "position_code": "0xE6",
        "size_code": "0xE7"
      },
      "vcp_named_values": {
        "PIP_Source_HDMI1": 17,
        "PIP_Source_HDMI2": 18,
        "PIP_Source_DP1": 15,
        "PIP_Source_DP2": 16,
        "PIP_Source_USB-C": 27,
        "PIP_Pos_TopLeft": 1,
        "PIP_Pos_TopRight": 2,
        "PIP_Pos_BottomLeft": 3,
        "PIP_Pos_BottomRight": 4,
        "PIP_Size_Small": 1,
        "PIP_Size_Medium": 2,
        "PIP_Size_Large": 3
      }
    },
    {
      "name": "LG UltraGear OLED 45GX950A",
      "input_select": { "code": "0x60", "values": { "DisplayPort": 15, "HDMI1": 17 } }
    }
  ],
  "monitors": [
    { "identifier": "Primary", "model": "U4025QW" },
    { "identifier": "Right",   "model": "U3225QE" },
    { "identifier": "LG45GX950A", "model": "LG UltraGear OLED 45GX950A" }
  ],
  "hotkeys": [
    { "keys": "ctrl+alt+d", "action": "SetInputSource", "args": {"source": "DisplayPort"}, "target": "LG45GX950A@4" },
    { "keys": "ctrl+alt+h", "action": "SetInputSource", "args": {"source": "HDMI1"}, "target": "LG45GX950A@4" }
  ],
  "cli": {
    "linux_ddcutil_path": "ddcutil",
    "mac_ddcctl_path": "ddcctl",
    "win_controlmymonitor_path": "ControlMyMonitor.exe"
  }
